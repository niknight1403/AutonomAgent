{
  "name": "@autonomagent/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "pretest": "npm run prisma:generate && npm run build --workspace @autonomagent/trading-core",
    "build": "npm run build --workspace @autonomagent/trading-core && tsc -p tsconfig.build.json",
    "prebuild": "npm run prisma:generate",
    "start": "node dist/services/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run prisma:generate && npm run build --workspace @autonomagent/trading-core",
    "test": "vitest run src",
    "admin:create": "tsx scripts/create-admin.ts",
    "sessions:cleanup": "tsx scripts/cleanup-sessions.ts"
  },
  "dependencies": {
    "@autonomagent/trading-core": "0.4.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "effect": "^3.22.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  }
}
