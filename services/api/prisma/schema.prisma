generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum LedgerEntryType {
  DEPOSIT
  RESERVATION
  RESERVATION_RELEASE
  PURCHASE
  MARKETPLACE_FEE
  SHIPPING
  SALE_SETTLEMENT
  REFUND
  ADJUSTMENT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshSessions RefreshSession[]
}

model RefreshSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique @db.VarChar(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedById String?
  createdAt   DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model WalletAccount {
  id                String         @id @default(cuid())
  ownerId           String
  currency          String         @default("EUR")
  balanceCents      BigInt         @default(0)
  reservedCents     BigInt         @default(0)
  version           Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  ledgerEntries     WalletLedger[]

  @@unique([ownerId, currency])
}

model WalletLedger {
  id            String          @id @default(cuid())
  accountId     String
  account       WalletAccount   @relation(fields: [accountId], references: [id])
  entryType     LedgerEntryType
  amountCents   BigInt
  referenceId   String          @unique
  reservationReferenceId String?
  reservation   WalletLedger?   @relation("ReservationReleases", fields: [reservationReferenceId], references: [referenceId], onDelete: Restrict)
  releases      WalletLedger[] @relation("ReservationReleases")
  correlationId String?
  description   String
  createdAt     DateTime        @default(now())

  @@index([accountId, createdAt])
  @@index([reservationReferenceId])
  @@index([correlationId])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateId   String
  correlationId String?
  schemaVersion Int          @default(1)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  leaseUntil    DateTime?
  lockedBy      String?
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
  @@index([leaseUntil])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  scope       String
  key         String
  requestHash String
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  CHECKPOINTED
  SUCCEEDED
  FAILED
  CANCELLED
}

model AgentTask {
  id             String          @id @default(cuid())
  ownerId        String
  taskType       String
  status         ExecutionStatus @default(QUEUED)
  input          Json
  inputHash      String?         @db.VarChar(64)
  result         Json?
  checkpoint     Json?
  correlationId  String?
  idempotencyKey String          @unique
  attempt        Int             @default(0)
  maxAttempts    Int             @default(3)
  availableAt    DateTime        @default(now())
  lockedBy       String?
  leaseUntil     DateTime?
  lastError      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([status, availableAt])
  @@index([ownerId, createdAt])
  @@index([leaseUntil])
}

enum DealReviewStatus {
  DISCOVERED
  APPROVED
  REJECTED
  ARCHIVED
}

model DealCandidate {
  id                       String           @id @default(cuid())
  providerId               String
  externalId               String
  title                    String
  productUrl               String
  currency                 String           @default("EUR")
  purchasePriceMinor       BigInt
  observedAt               DateTime
  simulated                Boolean          @default(false)
  totalCostCents           BigInt
  expectedProfitCents      BigInt
  roiBasisPoints           BigInt?
  riskPassed               Boolean
  riskReasons              Json
  reviewStatus             DealReviewStatus @default(DISCOVERED)
  reviewedBy               String?
  reviewedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@unique([providerId, externalId])
  @@index([reviewStatus, updatedAt])
  @@index([riskPassed, expectedProfitCents])
  @@index([observedAt])
}

